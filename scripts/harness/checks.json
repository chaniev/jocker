{
  "schemaVersion": 1,
  "checks": {
    "instructions": [
      "python3",
      "scripts/harness/verify.py",
      "instructions"
    ],
    "harness-tests": [
      "python3",
      "-m",
      "unittest",
      "discover",
      "-s",
      "scripts/harness/tests",
      "-v"
    ],
    "full-tests": [
      "bash",
      "scripts/run_all_tests.sh"
    ],
    "training-smoke": [
      "bash",
      "scripts/run_training_pipeline_smoke.sh"
    ],
    "joker": [
      "bash",
      "scripts/run_joker_regression_pack.sh"
    ],
    "phase": [
      "bash",
      "scripts/run_stage4_phase_guardrails.sh"
    ],
    "ranking": [
      "bash",
      "scripts/run_stage6b_ranking_guardrails.sh",
      "--include-flow-plumbing"
    ],
    "target-membership": [
      "python3",
      "scripts/harness/targets.py"
    ],
    "requirements": [
      "python3",
      "scripts/validate_requirements.py"
    ]
  },
  "rules": [
    {
      "patterns": [
        "**/AGENTS.md",
        "AGENTS.md",
        ".agents/**",
        ".codex/**",
        "docs/**",
        "README.md",
        "backlog/**"
      ],
      "checks": []
    },
    {
      "patterns": [
        "Jocker/Jocker/Models/Bot/**",
        "Jocker/Jocker/Game/Services/AI/**",
        "Jocker/JockerTests/Bot/**"
      ],
      "checks": [
        "joker",
        "phase",
        "ranking",
        "training-smoke"
      ]
    },
    {
      "patterns": [
        "**/BotSelfPlayEvolutionEngine*.swift",
        "**/BotTuning+SelfPlayEvolution.swift",
        "Jocker/JockerSelfPlayTools/**"
      ],
      "checks": [
        "full-tests",
        "training-smoke"
      ]
    },
    {
      "patterns": [
        "Jocker/Jocker/Models/**",
        "Jocker/Jocker/Scoring/**",
        "Jocker/JockerTests/Rules/**",
        "Jocker/JockerTests/Scoring/**",
        "правила игры/**"
      ],
      "checks": [
        "joker",
        "full-tests"
      ]
    },
    {
      "patterns": [
        "Jocker/Jocker/Game/Scenes/**",
        "Jocker/Jocker/Game/Coordinator/**",
        "Jocker/Jocker/Game/Services/Flow/**",
        "Jocker/JockerTests/Flow/**"
      ],
      "checks": [
        "ranking",
        "full-tests"
      ]
    },
    {
      "patterns": [
        "Jocker/Jocker/ViewControllers/Results/**",
        "Jocker/JockerTests/Results/**",
        "Jocker/JockerTests/JockerTests.swift",
        "Jocker/JockerUITests/GameRepeatResultsFlowUITests.swift"
      ],
      "checks": [
        "results-tests"
      ]
    },
    {
      "patterns": [
        "Jocker/Jocker/ViewControllers/Statistics/**",
        "Jocker/Jocker/Game/Services/Statistics/**",
        "Jocker/JockerTests/Statistics/**"
      ],
      "checks": [
        "statistics-tests"
      ]
    },
    {
      "patterns": [
        "Jocker/Jocker/Game/Services/History/**",
        "Jocker/JockerTests/History/**"
      ],
      "checks": [
        "history-tests"
      ]
    },
    {
      "patterns": [
        "Jocker/Jocker/Game/Services/Settings/**",
        "Jocker/JockerTests/Players/**"
      ],
      "checks": [
        "settings-tests"
      ]
    }
  ],
  "fallback": [
    "full-tests",
    "training-smoke"
  ],
  "ci": [
    "full-tests",
    "training-smoke"
  ],
  "testPacks": [
    "joker",
    "phase",
    "ranking"
  ],
  "testGroups": {
    "results-tests": [
      "Jocker/JockerTests/Results/**/*.swift",
      "Jocker/JockerTests/JockerTests.swift",
      "Jocker/JockerUITests/GameRepeatResultsFlowUITests.swift"
    ],
    "statistics-tests": [
      "Jocker/JockerTests/Statistics/**/*.swift",
      "Jocker/JockerTests/Results/GameResultsPresentationIntegrationTests.swift"
    ],
    "history-tests": [
      "Jocker/JockerTests/History/**/*.swift",
      "Jocker/JockerTests/Results/DealHistoryPresentationBuilderTests.swift"
    ],
    "settings-tests": [
      "Jocker/JockerTests/Players/**/*.swift",
      "Jocker/JockerUITests/GameRepeatResultsFlowUITests.swift"
    ]
  }
}
